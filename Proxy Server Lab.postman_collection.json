          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\npm.test(\"Content-Type is image/jpeg\", function () {\r\n    pm.response.to.have.header(\"Content-Type\", \"image/jpeg\");\r\n});\r\npm.test(\"Source is http.cat\", function () {\r\n    pm.response.to.have.header(\"Cache-Source\", \"http.cat\");\r\n});"
            ]
